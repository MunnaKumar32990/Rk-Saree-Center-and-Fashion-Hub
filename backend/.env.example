# ─────────────────────────────────────────────────────────────────────────────
# RK Saree Center — API configuration
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# Every value below has a safe default unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Must be a REPLICA SET connection string, not a standalone server:
# the inventory decrement/restore path uses transactions to prevent overselling,
# and transactions silently do nothing on a standalone mongod.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rk-saree-db?retryWrites=true&w=majority

# Connection pool. The critical constraint is:
#     API instances x MONGO_POOL_MAX <= the cluster's connection allowance
# At 8 instances the default of 30 asks for 240 sockets, which exceeds what a
# small cluster will hand out and produces errors that look like app bugs.
# Either lower this or raise the cluster allowance — pick one deliberately.
MONGO_POOL_MAX=30
MONGO_POOL_MIN=4

# Escape hatch for a standalone dev database, where transactions do not exist.
# NEVER set this in production: without transactions, stock decrement is no
# longer atomic and concurrent orders can oversell the same unit.
MONGO_TRANSACTIONS=true

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every existing session, which is the intent after an
# incident.
JWT_SECRET=replace_me_with_48_random_hex_characters_minimum_32
JWT_EXPIRES_IN=24h

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Use TEST keys during development, LIVE keys in production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_SECRET=your_razorpay_secret_key_here

# REQUIRED when Razorpay is configured — the server refuses to boot without it.
# This is the secret Razorpay signs each webhook with, and it is the ONLY thing
# proving a `payment.captured` event really came from Razorpay. Without it,
# anyone can POST a forged event and mark an unpaid order as paid.
# Razorpay Dashboard -> Settings -> Webhooks -> the secret for your endpoint.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Cloudinary (product image uploads) ──────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Frontend URL (CORS allow-list) ──────────────────────────────────────────
# Comma-separated. Must include every origin that talks to this API.
FRONTEND_URL=http://localhost:5173

# Public site URL, used for the sitemap, canonical links and email links.
PUBLIC_URL=http://localhost:5173

# ─── Business contact (shown to customers) ───────────────────────────────────
BUSINESS_PHONE=+919999999999
BUSINESS_WHATSAPP=919999999999
BUSINESS_EMAIL=orders@example.com

# ─── Email (verification, order updates, password reset) ─────────────────────
# Gmail: enable 2FA then create an App Password at
# https://myaccount.google.com/apppasswords
# An App Password looks like "abcd efgh ijkl mnop" (16 chars, spaces optional).
# NEVER commit a real one. Order and password emails are skipped entirely if
# EMAIL_USER/EMAIL_PASS are missing, and the server logs a warning at boot.
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=RK Saree Center
ADMIN_RECEIVER_EMAIL=your_gmail@gmail.com

# ─── COD / WhatsApp order confirmation (biggest RTO lever) ───────────────────
# Sends the customer a WhatsApp message asking them to confirm the COD order.
# Indian ethnic-wear COD returns run 30-45%, and every unreleased order is real
# money lost to return logistics.
COD_CONFIRM_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# REQUIRED when COD_CONFIRM_ENABLED=true — the server refuses to boot without it.
# Meta signs every inbound message with this. Without it the webhook cannot tell
# a genuine customer reply from an attacker, and an attacker who can POST a
# phone number plus "CANCEL" can cancel that customer's order.
# Meta App Dashboard -> your app -> Settings -> Basic -> App Secret.
WHATSAPP_APP_SECRET=

# ─── Pincode serviceability (India Post public API fallback) ─────────────────
PINCODE_LOOKUP_ENABLED=true

# ─── Rate limits ─────────────────────────────────────────────────────────────
# Counters are shared across every API instance via Mongo, so these limits hold
# no matter how many instances are running. Lowering AUTH_RATE_LIMIT_MAX is the
# single most effective lever against credential stuffing.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
ORDER_RATE_LIMIT_MAX=10

# ─── Caching and background work ─────────────────────────────────────────────
# Facets (category/colour/price aggregations) are cached per instance. Lower TTL
# means fresher data and more aggregation load; raise it for cheaper reads.
FACETS_CACHE_TTL_MS=300000
# Product view counts are buffered in memory and flushed on this interval, so a
# deploy loses at most this much view data. Eventual consistency is fine here.
VIEW_FLUSH_INTERVAL_MS=60000
