# Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────
# Get this from MongoDB Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rk-saree-db?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────
# Any long random string — keep it secret!
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# ── Razorpay ─────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Use TEST keys during development, LIVE keys in production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_SECRET=your_razorpay_secret_key_here

# ── Cloudinary (for product image uploads) ───
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Frontend URL (for CORS whitelist) ────────
FRONTEND_URL=http://localhost:5173

# ── Email Configuration (for verification & notifications) ───
# For Gmail: Enable "Less secure app access" or use App Password
EMAIL_SERVICE=gmail
EMAIL_USER=rksareecenter32@gmail.com
EMAIL_PASS=zjtq lgri bodr emem
