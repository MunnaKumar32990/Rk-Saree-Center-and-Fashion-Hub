# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ── Backend API URL ──────────────────────────
# Point this to your deployed backend URL in production
VITE_API_URL=http://localhost:5000/api

# ── Store Contact & WhatsApp (Masked by default in source code) ───
# In production, set your live business contact number:
VITE_BUSINESS_PHONE=+91 97087 56854
VITE_WHATSAPP_NUMBER=919708756854

